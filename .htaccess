# ============================================================
# SGAU — .htaccess racine — Sécurité renforcée
# ============================================================

# Désactiver le listage des répertoires
Options -Indexes

# ---- Blocage des fichiers et dossiers sensibles ----
# Bloquer l'accès direct au fichier .env
<Files ".env">
    Require all denied
</Files>

# Bloquer les fichiers de sauvegarde et de configuration
<FilesMatch "\.(env|bak|log|sql|sqlite|db|ini|pem|key|crt)$">
    Require all denied
</FilesMatch>

# Bloquer l'accès direct aux répertoires internes de l'application
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /university-system/

    # Interdire l'accès aux dossiers internes
    RewriteRule ^(app|bootstrap|config|database|routes|vendor|scratch)(/.*)?$ - [F,L]

    # Ne pas réécrire les requêtes déjà dans public/
    RewriteRule ^public/ - [L]

    # Servir les fichiers de stockage (photos, uploads) depuis public/storage
    RewriteRule ^storage/(.*)$ public/storage/$1 [L,QSA]

    # Servir les ressources statiques depuis public/assets
    RewriteRule ^assets/(.*)$ public/assets/$1 [L,QSA]

    # Tout le reste est routé vers public/index.php
    RewriteRule ^.*$ public/index.php [L,QSA]
</IfModule>

# ---- En-têtes de sécurité HTTP ----
<IfModule mod_headers.c>
    # Empêcher le clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Empêcher le MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Politique de référent
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Empêcher XSS dans les anciens navigateurs
    Header always set X-XSS-Protection "1; mode=block"
    # Désactiver le cache des pages authentifiées (évite la fuite de données sensibles)
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    # Restreindre les permissions du navigateur (caméra, micro, géolocalisation)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

